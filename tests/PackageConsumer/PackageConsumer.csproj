<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>annotations</Nullable>
    <IsPackable>false</IsPackable>
    <EnginePackageVersion Condition="'$(EnginePackageVersion)' == ''">1.0.0-preview.1</EnginePackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CardProbability.Engine" Version="[$(EnginePackageVersion)]" />
  </ItemGroup>
</Project>
