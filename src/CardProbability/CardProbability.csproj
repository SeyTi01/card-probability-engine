<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>annotations</Nullable>
    <AssemblyName>CardProbability</AssemblyName>
    <RootNamespace>CardProbability</RootNamespace>
    <PackageId>CardProbability.Engine</PackageId>
    <Version>1.0.0</Version>
    <Authors>SeyTi01</Authors>
    <Description>A synchronous, domain-neutral probability engine for finite decks, overlapping goals, distinct physical copies, and fixed-order draw, search and excavation effects.</Description>
    <PackageProjectUrl>https://github.com/SeyTi01/card-probability-engine</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SeyTi01/card-probability-engine</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>probability;cards;combinatorics;deck;calculation</PackageTags>
    <PackageReleaseNotes>First stable release for .NET 10. Includes exact rational results, overlapping goal unions, fixed-order effects, and explicit accuracy and resource outcomes. See the README for supported scope and model limitations.</PackageReleaseNotes>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591;CS1570;CS1572;CS1573;CS1574;CS1587</WarningsAsErrors>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>portable</DebugType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EnablePackageValidation>true</EnablePackageValidation>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>

