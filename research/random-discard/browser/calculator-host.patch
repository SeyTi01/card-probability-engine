+public sealed class DangerRevealIntegrationTest {
+    [Test]
+    public void FastUpperPrimaryAndCertifiedRevealIntervalReachEveryDisplayedRowWithoutASearch() {
+        Engine.RationalProbability upper = new("51", "100");
+        Engine.ProbabilityValue value = new(.51, upper, Engine.ProbabilityAccuracy.Bounded, new(new("1", "2"), upper));
+        Engine.CalculationResult response = new(
+            Engine.CalculationStatus.Completed, Engine.CalculationMode.Fast, Engine.ModelScope.FixedOrderEffects,
+            "Fixed-order reveal", Engine.ProbabilityAccuracy.Bounded, value, [new("0", value)], [new("g", 1, value)], new(1, 99, 1, 1)
+        ) { Certification = Engine.CertificationStatus.Bounded };
+        ProbabilityCalculationResult adapted = CalculationResultAdapter.Translate(response,
+            [new([], "Target", groupId: "g", cards: [new("target", 1, 1)])], [new("g", "Group")], CalculationModel.Fast);
+        string json = JsonSerializer.Serialize(new CalculationResponse(adapted, null), CalculationJsonContext.Default.CalculationResponse);
+        ProbabilityCalculationResult result = CalculationWire.ReadResult(json, CalculationModel.Fast);
+        foreach (ProbabilityRow row in new[] { ProbabilityRow.Total, ProbabilityRow.Combo, ProbabilityRow.Group }) {
+            ProbabilityDisplay display = ProbabilityPresentation.Create(result.TotalProbability, result.Contract, result.SearchAvailability,
+                row, 0, CultureInfo.InvariantCulture);
+            Assert.That(display.Value, Is.EqualTo("50.50%"));
+            Assert.That(display.Accuracy, Is.EqualTo("±0.50%"));
+            Assert.That(display.Evidence, Does.Contain("1/2").And.Contain("51/100"));
+        }
+    }
+
+    [TestCase(43316238, 1, 2)]
+    [TestCase(70711847, 2, 3)]
+    public async Task DisabledCopyMatchesOnlyItsCanonicalIdentityThroughSavedSessionAndWorker(
+        int disabledIdentity,
+        int numerator,
+        int denominator
+    ) {
+        CardEffectRegistry registry = CardEffectRegistry.Default;
+        Card source = registry.CreateImportedCard(new() { Id = 43316238, Name = "Identical label" }, 1, 43316238);
+        Card disabled = registry.CreateImportedCard(new() { Id = disabledIdentity, Name = "Identical label" }, 1, disabledIdentity)
+            .WithSimulationEnabled(false);
+        SessionService codec = SessionFixture.CreateCodec();
+        SessionState session = await codec.LoadSessionAsync(codec.SerializeSession(new() {
+            Cards = [source, disabled, new([], id: "target")],
+            Combos = [new([], cards: [new("target", 1, 2)])],
+            HandSize = 2
+        }));
+        Assert.That(session.Cards[0].IsDangerReveal, Is.True);
+        Assert.That(session.Cards[1].IsDangerReveal && !session.Cards[1].SimulationEnabled, Is.True);
+
+        // Three equiprobable opening pairs. Disabled + target always wins.
+        // Source + target wins on the source discard. Source + disabled wins
+        // only on a mismatching disabled discard followed by drawing the target.
+        foreach (CalculationModel mode in new[] { CalculationModel.Exact, CalculationModel.Fast, CalculationModel.OpeningHand }) {
+            CalculationSnapshot snapshot = CalculationSnapshot.Capture(session.Cards, session.Combos, 2, [], options: new(Mode: mode));
+            ProbabilityCalculationResult result = CalculationWire.ReadResult(CalculationWire.Execute(snapshot.Json), mode);
+            double expected = mode == CalculationModel.OpeningHand ? 2.0 / 3 : (double)numerator / denominator;
+            Assert.That(result.TotalProbability, Is.EqualTo(expected).Within(1e-14));
+            Assert.That(result.Contract!.Accuracy, Is.EqualTo(CalculationAccuracy.Exact));
+        }
+    }
